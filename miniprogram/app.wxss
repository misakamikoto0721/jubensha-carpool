page {
  background: #f5f6f8;
  color: #1c2430;
  font-size: 30rpx;
  line-height: 1.5;
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.kicker {
  display: block;
  color: #1a56b0;
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.title {
  display: block;
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.3;
}

.muted {
  color: #8a94a6;
}

.ban {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: #f6e4dc;
  color: #8f2d2a;
  border-radius: 12rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 36rpx rgba(36, 28, 22, 0.06);
}

.field {
  margin-top: 28rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #6d645b;
  font-size: 24rpx;
}

.input,
.picker {
  height: 88rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border: 1px solid #e6dccb;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 30rpx;
}

.picker {
  line-height: 88rpx;
}

button {
  margin: 0;
  padding: 0 24rpx;
  background: transparent;
  line-height: 88rpx;
  font-size: 30rpx;
}

button::after {
  border: none;
}

.primary,
.ghost {
  height: 88rpx;
  border-radius: 12rpx;
  text-align: center;
}

.primary {
  background: #1a56b0;
  color: #ffffff;
}

.ghost {
  background: #ffffff;
  color: #1c2430;
  border: 1px solid #d5dbe3;
}

.slim {
  flex-shrink: 0;
  height: 64rpx;
  margin-top: 8rpx;
  padding: 0 28rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
}

.block {
  width: 100%;
  margin-top: 36rpx;
}

.hint {
  margin-top: 24rpx;
  color: #6d645b;
  font-size: 26rpx;
}
