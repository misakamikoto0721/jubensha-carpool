.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.head-copy {
  flex: 1;
  min-width: 0;
}

.list {
  margin-top: 28rpx;
}

.session {
  margin-bottom: 20rpx;
}

.session-hover {
  background: #f7f1e6;
}

.session-top,
.session-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.script {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.3;
}

.meta {
  display: block;
  margin-top: 8rpx;
  color: #6d645b;
  font-size: 26rpx;
}

.session-bottom {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1px solid #efe6d8;
}

.remain {
  font-size: 30rpx;
  font-weight: 600;
}

.remain.hot {
  color: #1a56b0;
}

.pill {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.6;
}

.pill-open {
  background: #e5efe8;
  color: #3f5c4b;
}

.pill-full,
.pill-pending {
  background: #f6e4dc;
  color: #8f2d2a;
}

.pill-completed,
.pill-closed {
  background: #eee7dc;
  color: #6d645b;
}

.empty {
  margin-top: 48rpx;
}

.empty-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
}

.empty-sub {
  display: block;
  margin-top: 8rpx;
  color: #6d645b;
}
