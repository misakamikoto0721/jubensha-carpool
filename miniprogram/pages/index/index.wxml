<view class="page">
  <view class="head">
    <view class="head-copy">
      <text class="title">正在报名</text>
    </view>
    <button wx:if="{{canCreate}}" class="primary slim" bindtap="goCreate">发车</button>
  </view>

  <view class="ban" wx:if="{{user && user.banText}}">{{user.banText}}</view>

  <view wx:if="{{loading}}" class="hint">正在加载</view>
  <view wx:elif="{{sessions.length === 0}}" class="empty">
    <text class="empty-title">还没有车</text>
    <text class="empty-sub">DM 发出一场后，会出现在这里。</text>
  </view>
  <view wx:else class="list">
    <view
      class="card session"
      wx:for="{{sessions}}"
      wx:key="id"
      data-id="{{item.id}}"
      hover-class="session-hover"
      bindtap="openDetail"
    >
      <view class="session-top">
        <text class="script">{{item.scriptName}}</text>
        <text class="pill pill-{{item.pendingMark ? 'pending' : item.status}}">{{item.statusText}}</text>
      </view>
      <text class="meta">{{item.kindText}} · {{item.timeText}}</text>
      <text class="meta" wx:if="{{item.drawText}}">{{item.drawText}}</text>
      <text class="meta">{{item.location}}</text>
      <view class="session-bottom">
        <text class="remain {{item.remainOpen ? 'hot' : ''}}">{{item.remainText}}</text>
        <text class="muted">{{item.seatText}}<text wx:if="{{item.dmName}}"> · {{item.dmName}}</text></text>
      </view>
    </view>
  </view>
</view>
