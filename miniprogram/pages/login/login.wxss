.gate {
  min-height: 100vh;
  padding: 180rpx 64rpx 96rpx;
  box-sizing: border-box;
  background-color: #1a56b0;
  background-image:
    radial-gradient(circle at 12% 18%, rgba(255, 255, 255, 0.22) 0, rgba(255, 255, 255, 0) 28%),
    radial-gradient(circle at 88% 8%, rgba(255, 255, 255, 0.16) 0, rgba(255, 255, 255, 0) 26%),
    linear-gradient(165deg, rgba(255, 255, 255, 0.08) 0, rgba(255, 255, 255, 0) 42%);
}

.gate-mark {
  width: 128rpx;
  height: 128rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 50%;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 128rpx;
  text-align: center;
  letter-spacing: 2rpx;
}

.gate-school {
  display: block;
  margin-top: 48rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  letter-spacing: 4rpx;
}

.gate-app {
  display: block;
  margin-top: 16rpx;
  color: #ffffff;
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1.25;
}

.enter {
  width: 100%;
  height: 96rpx;
  margin-top: 120rpx;
  padding: 0;
  background: #ffffff;
  color: #1a56b0;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 96rpx;
  text-align: center;
}

.temp {
  width: 100%;
  height: 96rpx;
  margin-top: 24rpx;
  padding: 0;
  background: transparent;
  color: #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 48rpx;
  font-size: 32rpx;
  line-height: 92rpx;
  text-align: center;
}
