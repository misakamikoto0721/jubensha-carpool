.login {
  box-sizing: border-box;
  min-height: 100%;
  padding: 48rpx 48rpx 120rpx;
  background: #ffffff;
}

.logo {
  display: block;
  width: 460rpx;
  height: 460rpx;
  margin: 24rpx auto 0;
}

.heading {
  display: block;
  margin-top: 56rpx;
  color: #1a56b0;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.3;
}

.sub {
  display: block;
  margin-top: 12rpx;
  color: #b0b7c3;
  font-size: 28rpx;
}

.pill {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  margin-top: 48rpx;
  padding: 0 36rpx;
  background: #3d8bfd;
  border-radius: 48rpx;
  box-sizing: border-box;
}

.pill-hover {
  opacity: 0.86;
}

.pill-text,
.pill-arrow {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
}

.temp {
  margin-top: 28rpx;
  background: #ffffff;
  border: 2rpx solid #3d8bfd;
}

.temp .pill-text,
.temp .pill-arrow {
  color: #3d8bfd;
}
