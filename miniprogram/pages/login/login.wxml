<view class="login">
  <image class="logo" src="/assets/club-logo.png" mode="aspectFit" />
  <text class="heading">剧本杀拼车</text>
  <text class="sub">登录后进入拼车</text>
  <view class="pill" hover-class="pill-hover" bindtap="openUstc">
    <text class="pill-text">统一身份认证登录</text>
    <text class="pill-arrow">→</text>
  </view>
  <view wx:if="{{devLogin}}" class="pill temp" hover-class="pill-hover" bindtap="useDevAccount">
    <text class="pill-text">临时登录</text>
    <text class="pill-arrow">→</text>
  </view>
</view>
