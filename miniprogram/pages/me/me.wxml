<view class="me" wx:if="{{!loading && user}}">
  <view class="hero">
    <view class="who">
      <view class="avatar">{{initial}}</view>
      <view class="who-copy">
        <text class="who-line">{{user.name}} | {{user.studentId}}</text>
        <text class="who-sub">{{user.roleText}}</text>
      </view>
    </view>
  </view>

  <view class="stat-card">
    <view class="stat">
      <text class="stat-label">身份</text>
      <text class="stat-value">{{user.roleText}}</text>
    </view>
    <view class="stat-split"></view>
    <view class="stat">
      <text class="stat-label">爽约</text>
      <text class="stat-value">{{user.noShowCount || 0}}</text>
    </view>
  </view>

  <view class="ban ban-pad" wx:if="{{user.banText}}">{{user.banText}}</view>

  <view class="panel" wx:if="{{user.role === 'admin'}}">
    <text class="panel-title">DM 工作组</text>
    <text class="hint">填写对方学号。加入后，对方可以发车。</text>
    <view class="field">
      <text class="label">学号</text>
      <input class="input" placeholder="例如 PB220001" value="{{dmStudentId}}" bindinput="onDmStudentId" />
    </view>
    <button class="primary block" bindtap="grantDm">加入 DM</button>
    <button class="ghost block" bindtap="revokeDm">移出 DM</button>
  </view>

  <button class="logout" bindtap="logout">登出</button>
</view>

<view class="me empty" wx:elif="{{!loading}}">
  <text class="empty-title">尚未登录</text>
</view>
