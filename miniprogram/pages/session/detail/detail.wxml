<view class="page dock-page">
  <view wx:if="{{loading}}" class="hint">正在加载</view>

  <view wx:elif="{{missing || !session}}" class="empty">
    <text class="title">没有这场车</text>
    <button class="ghost block" bindtap="goHome">返回列表</button>
  </view>

  <block wx:else>
    <text class="kicker">{{session.kindText}} · {{session.statusText}}</text>
    <text class="title">{{session.scriptName}}</text>
    <text class="remain {{session.remainOpen ? 'hot' : ''}}">{{session.remainText}}</text>
    <text class="seat">{{session.seatText}}</text>

    <view class="facts">
      <text class="fact">{{session.timeText}}</text>
      <text class="fact" wx:if="{{session.drawText}}">{{session.drawText}}</text>
      <text class="fact">{{session.location}}</text>
      <text class="fact" wx:if="{{session.dmName}}">DM {{session.dmName}}</text>
    </view>

    <view class="section" wx:if="{{session.drawStatus === 'done'}}">
      <text class="section-title">未抽中</text>
      <view wx:if="{{missed.length === 0}}" class="hint tight">没有人未抽中</view>
      <view wx:for="{{missed}}" wx:key="uid" class="member">
        <text>{{item.name}}</text>
        <text class="muted">{{item.statusText}}</text>
      </view>
    </view>

    <view class="section" wx:if="{{session.kind === 'weekly' && session.drawStatus !== 'done'}}">
      <text class="section-title">等待抽签</text>
      <view wx:if="{{applicants.length === 0}}" class="hint tight">还没有人报名</view>
      <view wx:for="{{applicants}}" wx:key="uid" class="member">
        <text>{{item.name}}</text>
        <text class="muted">{{item.statusText}}</text>
      </view>
    </view>

    <view class="section">
      <text class="section-title">车上的人</text>
      <view wx:if="{{members.length === 0}}" class="hint tight">{{session.kind === 'weekly' ? '抽签之后才会出现在这里' : '还没有人上车'}}</view>
      <view wx:for="{{members}}" wx:key="uid" class="member">
        <text>{{item.name}}</text>
        <text class="muted">{{item.statusText}}</text>
      </view>
    </view>

    <text class="link" bindtap="copyLibrary">复制研讨室预约链接</text>

    <view class="section card" wx:if="{{canPull}}">
      <text class="section-title">超额拉入</text>
      <text class="hint tight">私车满员后，仍可以把已经登录过的人拉上车。</text>
      <input class="input pull-input" placeholder="学号" value="{{pullStudentId}}" bindinput="onPullStudentId" />
      <button class="primary block" bindtap="pullMember">拉入这场车</button>
    </view>

    <view class="section card" wx:if="{{canMark && draft.length}}">
      <text class="section-title">标记到场</text>
      <text class="hint tight">活动结束后提交。未到的人选爽约。</text>
      <view wx:for="{{draft}}" wx:key="uid" class="mark-row">
        <text>{{item.name}}</text>
        <view class="choices">
          <button
            class="choice {{item.status === 'attended' ? 'on' : ''}}"
            data-uid="{{item.uid}}"
            data-status="attended"
            bindtap="pickMark"
          >到场</button>
          <button
            class="choice {{item.status === 'no_show' ? 'on-bad' : ''}}"
            data-uid="{{item.uid}}"
            data-status="no_show"
            bindtap="pickMark"
          >爽约</button>
        </view>
      </view>
      <button class="primary block" bindtap="submitMarks">提交到场记录</button>
    </view>
    <view class="hint" wx:elif="{{canMark}}">还没有人上车，暂时不用标记。</view>
  </block>

  <view class="dock" wx:if="{{session}}">
    <button class="share" open-type="share">分享</button>
    <button wx:if="{{needBind}}" class="primary" bindtap="goLogin">登录后上车</button>
    <button wx:elif="{{canJoin}}" class="primary" bindtap="join">{{session.kind === 'weekly' ? '报名' : '上车'}}</button>
    <button wx:elif="{{canCancel}}" class="ghost danger" bindtap="cancelJoin">{{mySeat === 'waiting' ? '取消报名' : '取消上车'}}</button>
    <view wx:else class="dock-note">{{joinBlockReason}}</view>
  </view>
</view>
