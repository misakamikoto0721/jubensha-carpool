.dock-page {
  padding-bottom: 200rpx;
}

.remain {
  display: block;
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.2;
}

.remain.hot {
  color: #8f2d2a;
}

.seat {
  display: block;
  margin-top: 8rpx;
  color: #6d645b;
  font-size: 26rpx;
}

.facts {
  margin-top: 28rpx;
  padding: 24rpx 0;
  border-top: 1px solid #e6dccb;
  border-bottom: 1px solid #e6dccb;
}

.fact {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
}

.fact:first-child {
  margin-top: 0;
}

.section {
  margin-top: 36rpx;
}

.section-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 28rpx;
  color: #6d645b;
}

.hint.tight {
  margin-top: 8rpx;
}

.member,
.mark-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1px solid #efe6d8;
}

.link {
  display: inline-block;
  margin-top: 28rpx;
  color: #8f2d2a;
  font-size: 26rpx;
}

.choices {
  display: flex;
  gap: 12rpx;
}

.choice {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  border: 1px solid #e6dccb;
  color: #6d645b;
}

.choice.on {
  background: #241c16;
  color: #f6f1e7;
  border-color: #241c16;
}

.choice.on-bad {
  background: #8f2d2a;
  color: #fffdf8;
  border-color: #8f2d2a;
}

.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  align-items: center;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(243, 238, 228, 0.96);
  border-top: 1px solid #e6dccb;
}

.dock .share {
  flex: 0 0 auto;
  height: 88rpx;
  padding: 0 8rpx;
  color: #241c16;
  background: transparent;
}

.dock .primary,
.dock .ghost {
  flex: 1;
}

.danger {
  color: #8f2d2a;
}

.dock-note {
  flex: 1;
  color: #6d645b;
  text-align: center;
}
