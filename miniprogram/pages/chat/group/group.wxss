.room {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f6f8;
  box-sizing: border-box;
}

.log {
  flex: 1;
  height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.row.mine {
  flex-direction: row-reverse;
}

.face,
.face-img,
.face-fallback {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.face-img {
  display: block;
}

.face-fallback {
  overflow: hidden;
  background: #d5dbe3;
  color: #1a56b0;
  font-size: 28rpx;
  line-height: 72rpx;
  text-align: center;
}

.msg {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  max-width: 70%;
}

.mine .msg {
  align-items: flex-end;
}

.who {
  margin-bottom: 6rpx;
  color: #8a94a6;
  font-size: 22rpx;
}

.bubble {
  max-width: 100%;
  padding: 16rpx 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 1.5;
}

.mine .bubble {
  background: #1a56b0;
  color: #ffffff;
}

.composer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx 32rpx;
  background: #ffffff;
}

.composer .input {
  flex: 1;
}

.send {
  width: 140rpx;
  padding: 0;
}
