.room {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f6f8;
  box-sizing: border-box;
}

.head {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  background: #1a56b0;
  color: #ffffff;
}

.back {
  width: 64rpx;
  color: #ffffff;
  font-size: 40rpx;
  line-height: 72rpx;
  text-align: center;
}

.head-copy {
  flex: 1;
  min-width: 0;
}

.head-title,
.head-meta {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.head-title {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.3;
}

.head-meta {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}

.log {
  flex: 1;
  height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.row.mine {
  flex-direction: row-reverse;
}

.face,
.face-img,
.face-fallback {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.face-img {
  display: block;
}

.face-fallback {
  overflow: hidden;
  background: #d5dbe3;
  color: #1a56b0;
  font-size: 28rpx;
  line-height: 72rpx;
  text-align: center;
}

.msg {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  max-width: 70%;
}

.mine .msg {
  align-items: flex-end;
}

.who {
  margin-bottom: 6rpx;
  color: #8a94a6;
  font-size: 22rpx;
}

.bubble {
  max-width: 100%;
  padding: 16rpx 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 1.5;
}

.mine .bubble {
  background: #1a56b0;
  color: #ffffff;
}

.composer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx 32rpx;
  background: #ffffff;
}

.composer .input {
  flex: 1;
}

.send {
  width: 140rpx;
  padding: 0;
}

.drawer-mask,
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(28, 36, 48, 0.28);
  z-index: 20;
}

.drawer {
  position: fixed;
  right: 0;
  bottom: 0;
  width: 560rpx;
  box-sizing: border-box;
  background: #ffffff;
  transform: translateX(100%);
  transition: transform 0.2s ease;
  z-index: 21;
}

.drawer.open {
  transform: translateX(0);
}

.drawer-log {
  height: 100%;
  padding: 24rpx 16rpx 48rpx;
  box-sizing: border-box;
}

.mate {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 8rpx;
}

.mate-copy {
  flex: 1;
  min-width: 0;
}

.mate-name,
.mate-seat {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mate-name {
  font-size: 28rpx;
}

.mate-seat {
  color: #8a94a6;
  font-size: 22rpx;
}

.handle {
  position: fixed;
  right: 0;
  top: 46%;
  z-index: 22;
  width: 40rpx;
  height: 112rpx;
  background: #ffffff;
  color: #1a56b0;
  font-size: 36rpx;
  line-height: 112rpx;
  text-align: center;
  border-radius: 16rpx 0 0 16rpx;
  box-shadow: -6rpx 0 16rpx rgba(28, 36, 48, 0.08);
}

.handle.aside {
  right: 560rpx;
}

.sheet-mask {
  z-index: 30;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  box-sizing: border-box;
}

.sheet-who {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.sheet-avatar,
.sheet-img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
}

.sheet-avatar {
  overflow: hidden;
  background: #d5dbe3;
  color: #1a56b0;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 112rpx;
  text-align: center;
  flex-shrink: 0;
}

.sheet-img {
  display: block;
}

.sheet-copy {
  flex: 1;
  min-width: 0;
}

.sheet-line,
.sheet-sub {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sheet-line {
  font-size: 34rpx;
  font-weight: 600;
}

.sheet-sub {
  margin-top: 10rpx;
  color: #8a94a6;
  font-size: 26rpx;
}
